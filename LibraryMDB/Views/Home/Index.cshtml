@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="page-header">
    <h1>Library Management System</h1>
</div>

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-value">@Model.TotalTitles</div>
        <div class="stat-label">TITLES</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.AvailableTitles</div>
        <div class="stat-label">AVAILABLE</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@Model.OnLoanTitles</div>
        <div class="stat-label">ON LOAN</div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="quick-nav-cards">
        <a asp-controller="Books" asp-action="Index" class="quick-nav-card card-catalog">
            <h3>Books</h3>
            <p>Open catalog</p>
        </a>
        <a asp-controller="Borrow" asp-action="Index" class="quick-nav-card card-ledger">
            <h3>Borrow Records</h3>
            <p>Open ledger</p>
        </a>
    </div>

    <div class="status-panel">
        <h3>System Status</h3>
        <div class="status-row">
            <span class="label">Last filed</span>
            <span>@Model.LastFiled</span>
        </div>
        <div class="status-row">
            <span class="label">Most recent loan</span>
            <span>@Model.MostRecentLoan</span>
        </div>
        <div class="status-row">
            <span class="label">Overdue entries</span>
            <span>@Model.OverdueEntries</span>
        </div>
        <div class="status-row">
            <span class="label">System</span>
            <span>Browser-only</span>
        </div>
    </div>
</div>
