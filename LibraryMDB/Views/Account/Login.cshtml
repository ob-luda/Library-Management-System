@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="page-header">
    <h1>Identify Yourself</h1>
</div>

<div class="form-card">
    <div class="form-tag">SYSTEM ACCESS</div>
    <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div class="form-group">
            <label asp-for="CredentialId">CREDENTIAL ID / EMAIL</label>
            <input asp-for="CredentialId" placeholder="you@library.system" />
            <span asp-validation-for="CredentialId" class="field-validation-error"></span>
        </div>
        <div class="form-group">
            <label asp-for="Passphrase">PASSPHRASE</label>
            <input asp-for="Passphrase" type="password" placeholder="••••••••" />
            <span asp-validation-for="Passphrase" class="field-validation-error"></span>
        </div>
        <button type="submit" class="btn btn-primary">Authenticate</button>
    </form>
    <p class="version-tag">Demo access &middot; librarian@library.system / archive123</p>
</div>
